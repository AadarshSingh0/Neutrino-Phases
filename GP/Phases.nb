Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Fast", " ", "linear"}], "-", 
    RowBox[{
    "time", " ", "intersection", " ", "of", " ", "two", " ", "sorted", " ", 
     "interval", " ", "lists"}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"FastIntersect", "[", 
      RowBox[{"setA_List", ",", "setB_List"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"i", "=", "1"}], ",", 
         RowBox[{"j", "=", "1"}], ",", 
         RowBox[{"res", "=", 
          RowBox[{"{", "}"}]}], ",", "a", ",", "b", ",", "lo", ",", "hi"}], 
        "}"}], ",", 
       RowBox[{
        RowBox[{"While", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"i", "<=", 
            RowBox[{"Length", "[", "setA", "]"}]}], "&&", 
           RowBox[{"j", "<=", 
            RowBox[{"Length", "[", "setB", "]"}]}]}], ",", 
          RowBox[{
           RowBox[{"a", "=", 
            RowBox[{"setA", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}], ";", 
           RowBox[{"b", "=", 
            RowBox[{"setB", "[", 
             RowBox[{"[", "j", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"lo", "=", 
            RowBox[{"Max", "[", 
             RowBox[{
              RowBox[{"a", "[", 
               RowBox[{"[", "1", "]"}], "]"}], ",", 
              RowBox[{"b", "[", 
               RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"hi", "=", 
            RowBox[{"Min", "[", 
             RowBox[{
              RowBox[{"a", "[", 
               RowBox[{"[", "2", "]"}], "]"}], ",", 
              RowBox[{"b", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"hi", ">", "lo"}], ",", 
             RowBox[{"AppendTo", "[", 
              RowBox[{"res", ",", 
               RowBox[{"{", 
                RowBox[{"lo", ",", "hi"}], "}"}]}], "]"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"a", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "<", 
              RowBox[{"b", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], ",", 
             RowBox[{"i", "++"}], ",", 
             RowBox[{"j", "++"}]}], "]"}], ";"}]}], "]"}], ";", 
        "\[IndentingNewLine]", "res"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"intervals", " ", "around", " ", "the", " ", "zeros", " ", "of", " ", "s1", ",", " ", "s2", ",", " ", "s3"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"nf", "=", "100000"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"intervals1", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"c1", " ", "n"}], "-", "5"}], ",", 
         RowBox[{
          RowBox[{"c1", " ", "n"}], "+", "5"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", "1", ",", "nf"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"intervals2", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"c2", " ", "n"}], "-", "5"}], ",", 
         RowBox[{
          RowBox[{"c2", " ", "n"}], "+", "5"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", "1", ",", "nf"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"intervals3", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"c3", " ", "n"}], "-", "0.5"}], ",", 
         RowBox[{
          RowBox[{"c3", " ", "n"}], "+", "0.5"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", "1", ",", "nf"}], "}"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Three", "-", 
     RowBox[{
     "way", " ", "intersection", " ", "using", " ", "fast", " ", "method"}]}],
     "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"intersection3", "=", 
     RowBox[{"FastIntersect", "[", 
      RowBox[{
       RowBox[{"FastIntersect", "[", 
        RowBox[{"intervals1", ",", "intervals2"}], "]"}], ",", "intervals3"}],
       "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"Length", "[", "intersection3", "]"}], "\n"}]}]], "Input",
 CellChangeTimes->{{3.971396906578804*^9, 3.971396906579474*^9}, {
  3.971396943917906*^9, 3.971396948431088*^9}, {3.971397028396459*^9, 
