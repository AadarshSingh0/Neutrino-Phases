Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"yminsndPlot", "=", 
    RowBox[{"LogLogPlot", "[", 
     RowBox[{
      RowBox[{"yminsnd", "[", "x", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "0.1", ",", "minsnd"}], "}"}], ",", 
      RowBox[{"PlotStyle", "->", 
       RowBox[{"Directive", "[", 
        RowBox[{
         RowBox[{"colorList", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", "Dashed"}], "]"}]}], ",", 
      RowBox[{"PlotLegends", "->", 
       RowBox[{"{", 
        RowBox[{"Style", "[", 
         RowBox[{"\"\<SND E = 100 GeV\>\"", ",", 
          RowBox[{"FontSize", "->", "12"}], ",", 
          RowBox[{"FontFamily", "->", "\"\<Andika\>\""}]}], "]"}], "}"}]}]}], 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ymaxsndPlot", "=", 
    RowBox[{"LogLogPlot", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"ymaxsnd", "[", "x", "]"}], ",", "Y13"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "0.1", ",", "maxsnd"}], "}"}], ",", 
      RowBox[{"PlotStyle", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Directive", "[", 
          RowBox[{
           RowBox[{"colorList", "[", 
            RowBox[{"[", "2", "]"}], "]"}], ",", "Dashed"}], "]"}], ",", 
         RowBox[{"Directive", "[", 
          RowBox[{
           RowBox[{"RGBColor", "[", 
            RowBox[{"0.4", ",", "0.1", ",", "0.7"}], "]"}], ",", "Thick"}], 
          "]"}]}], "}"}]}], ",", 
      RowBox[{"PlotLegends", "->", 
       RowBox[{"{", 
        RowBox[{"Style", "[", 
         RowBox[{"\"\<SND E = 1 TeV\>\"", ",", 
          RowBox[{"FontSize", "->", "12"}], ",", 
          RowBox[{"FontFamily", "->", "\"\<Andika\>\""}]}], "]"}], "}"}]}], 
      ",", 
      RowBox[{"Filling", "->", 
       RowBox[{"{", 
        RowBox[{"2", "->", "Top"}], "}"}]}], ",", 
      RowBox[{"(*", 
       RowBox[{
       "Filling", " ", "from", " ", "the", " ", "second", " ", "curve", " ", 
        "to", " ", "the", " ", "top"}], "*)"}], 
      RowBox[{"FillingStyle", "->", 
       RowBox[{"Directive", "[", 
        RowBox[{
         RowBox[{"Opacity", "[", "0.3", "]"}], ",", 
         RowBox[{"RGBColor", "[", 
          RowBox[{"0.4", ",", "0.1", ",", "0.7"}], "]"}]}], "]"}]}]}], " ", 
     RowBox[{"(*", 
      RowBox[{"Optional", " ", "style", " ", "for", " ", "filling"}], "*)"}], 
     "]"}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{"Merge", " ", "the", " ", "plots"}], "*)"}]}], "\n", 
 RowBox[{"sndplot", "=", 
  RowBox[{"Show", "[", 
   RowBox[{"yminsndPlot", ",", "ymaxsndPlot", ",", 
    RowBox[{
    "PlotLabel", "->", 
     "\"\<Plot of mass (eV) vs \!\(\*SuperscriptBox[\(y\), \(2\)]\)\>\""}], 
    ",", 
    RowBox[{"LabelStyle", "->", 
     RowBox[{"Directive", "[", 
      RowBox[{"Black", ",", "Bold"}], "]"}]}], ",", 
    RowBox[{"PlotRange", "->", 
     RowBox[{"{", 
      RowBox[{"All", ",", 
       RowBox[{"{", 
        RowBox[{"Automatic", ",", "1"}], "}"}]}], "}"}]}], ",", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{
       RowBox[{"Limit", " ", "y"}], "-", 
       RowBox[{"axis", " ", "to"}]}], "<=", "1"}], "*)"}], 
    RowBox[{"Frame", "->", "True"}], ",", 
    RowBox[{"(*", 
     RowBox[{"Enable", " ", "frame"}], "*)"}], 
    RowBox[{"FrameLabel", "->", 
