Cell["Clockwork Pheno", "Subsubsection",
 CellChangeTimes->{{3.939002677137807*^9, 
  3.9390026811979723`*^9}},ExpressionUUID->"b7f550fd-e340-4d19-8db6-\
17160ec5a479"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Define", " ", "functions", " ", "for", " ", "plotting"}], "*)"}], 
  
  RowBox[{
   RowBox[{
    RowBox[{"ycw", "[", "x_", "]"}], ":=", 
    RowBox[{
     RowBox[{"10", "^", 
      RowBox[{"(", 
       RowBox[{"-", "2"}], ")"}]}], "/", 
     RowBox[{"(", 
      RowBox[{"Sqrt", "[", "2", "]"}], ")"}]}]}], "\n", 
   RowBox[{
    RowBox[{"y1", "[", "x_", "]"}], ":=", 
    RowBox[{
     RowBox[{"Sqrt", "[", 
      RowBox[{"10", "^", 
       RowBox[{"(", "7", ")"}]}], "]"}], "/", "x"}]}], "\n", 
   RowBox[{
    RowBox[{"y3", "[", "x_", "]"}], ":=", 
    RowBox[{
     RowBox[{"Sqrt", "[", 
      RowBox[{"10", "^", "1"}], "]"}], "/", "x"}]}], "\n", 
   RowBox[{
    RowBox[{"y4", "[", "x_", "]"}], ":=", 
    RowBox[{
     RowBox[{"Sqrt", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "/", "3"}], ")"}], "*", 
       RowBox[{"10", "^", 
        RowBox[{"(", 
         RowBox[{"-", "18"}], ")"}]}]}], "]"}], "/", "x"}]}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Generate", " ", "the", " ", "plot"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"LogPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"ycw", "[", "x", "]"}], ",", 
       RowBox[{"y1", "[", "x", "]"}], ",", 
       RowBox[{"y3", "[", "x", "]"}], ",", 
       RowBox[{"y4", "[", "x", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"1", "*", 
        RowBox[{"10", "^", "9"}]}], ",", 
       RowBox[{"1000", "*", 
        RowBox[{"10", "^", "9"}]}]}], "}"}], ",", 
     RowBox[{"PlotLabel", "->", "\"\<\>\""}], ",", 
     RowBox[{"Axes", "->", "False"}], ",", 
     RowBox[{"(*", 
      RowBox[{
      "Hide", " ", "default", " ", "axes", " ", "to", " ", "use", " ", 
       "frame"}], "*)"}], 
     RowBox[{"Frame", "->", "True"}], ",", 
     RowBox[{"(*", 
      RowBox[{
      "Enable", " ", "frame", " ", "around", " ", "the", " ", "plot"}], 
      "*)"}], 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{
       "\"\<m(eV)\>\"", ",", 
        "\"\<Log10(\!\(\*SubscriptBox[\(p\), \(\[Beta]\)]\))\>\"", ",", 
        "None", ",", "None"}], "}"}]}], ",", 
     RowBox[{"(*", 
      RowBox[{"Frame", " ", "labels"}], "*)"}], 
     RowBox[{"FrameStyle", "->", "Black"}], ",", 
     RowBox[{"(*", 
      RowBox[{"Frame", " ", "color"}], "*)"}], 
     RowBox[{"FrameTicks", "->", 
      RowBox[{"{", 
       RowBox[{"Automatic", ",", 
        RowBox[{"(*", 
         RowBox[{"x", "-", 
          RowBox[{"axis", " ", "ticks"}]}], "*)"}], 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"10", "^", "n"}], ",", "n"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"n", ",", 
            RowBox[{"-", "24"}], ",", "3", ",", "2"}], "}"}]}], "]"}]}], 
       "}"}]}], ",", 
     RowBox[{"(*", 
      RowBox[{"y", "-", 
       RowBox[{
       "axis", " ", "ticks", " ", "every", " ", "second", " ", "tick"}]}], 
      "*)"}], 
     RowBox[{"(*", 
      RowBox[{"Solid", " ", "colors", " ", "for", " ", "each", " ", "curve"}],
       "*)"}], 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Directive", "[", 
         RowBox[{
          RowBox[{"RGBColor", "[", 
           RowBox[{"1", ",", "0.4", ",", "0.4"}], "]"}], ",", "Thick"}], 
         "]"}], ",", 
        RowBox[{"(*", 
         RowBox[{"Red", " ", "for", " ", 
          RowBox[{"ycw", "[", "x", "]"}]}], "*)"}], 
        RowBox[{"Directive", "[", 
         RowBox[{
          RowBox[{"RGBColor", "[", 
           RowBox[{"0.4", ",", "1", ",", "0.4"}], "]"}], ",", "Thick"}], 
         "]"}], ",", 
        RowBox[{"(*", 
         RowBox[{"Light", " ", "Green", " ", "for", " ", 
          RowBox[{"y1", "[", "x", "]"}]}], "*)"}], 
        RowBox[{"(*", 
         RowBox[{"Blue", " ", "for", " ", 
          RowBox[{"y2", "[", "x", "]"}]}], "*)"}], 
        RowBox[{"Directive", "[", 
         RowBox[{
          RowBox[{"RGBColor", "[", 
           RowBox[{"0.6", ",", "0.3", ",", "1"}], "]"}], ",", "Thick"}], 
         "]"}], ",", 
        RowBox[{"(*", 
         RowBox[{"Purple", " ", "for", " ", 
          RowBox[{"y3", "[", "x", "]"}]}], "*)"}], 
        RowBox[{"Directive", "[", 
         RowBox[{
          RowBox[{"RGBColor", "[", 
           RowBox[{"1", ",", "0.6", ",", "0"}], "]"}], ",", "Thick"}], 
         "]"}]}], "          ", 
       RowBox[{"(*", 
        RowBox[{"Orange", " ", "for", " ", 
         RowBox[{"y4", "[", "x", "]"}]}], "*)"}], "}"}]}], ",", 
     RowBox[{"Filling", "->", 
      RowBox[{"{", 
       RowBox[{"1", "->", "Top"}], "}"}]}], ",", 
     RowBox[{"(*", 
      RowBox[{"Fills", " ", "area", " ", "above", " ", 
       RowBox[{"ycw", "[", "x", "]"}]}], "*)"}], 
     RowBox[{"FillingStyle", "->", "LightBlue"}], ",", 
     RowBox[{"(*", 
      RowBox[{"Color", " ", "for", " ", "the", " ", "filled", " ", "area"}], 
      "*)"}], 
     RowBox[{"LabelStyle", "->", 
      RowBox[{"Directive", "[", 
       RowBox[{"Black", ",", "Bold"}], "]"}]}], ",", 
     RowBox[{"PlotRange", "->", 
      RowBox[{"{", 
       RowBox[{"All", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"10", "^", 
           RowBox[{"(", 
            RowBox[{"-", "23"}], ")"}]}], ",", "10"}], "}"}]}], "}"}]}], ",", 
     
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"Limit", " ", "y"}], "-", 
       RowBox[{"axis", " ", 
        RowBox[{"to", "[", 
         RowBox[{
          RowBox[{"10", "^", 
           RowBox[{"-", "20"}]}], ",", "1000"}], "]"}]}]}], "*)"}], 
     RowBox[{"(*", 
      RowBox[{
      "Add", " ", "annotations", " ", "with", " ", "Epilog", " ", "and", " ", 
       "matching", " ", "background", " ", "colors"}], "*)"}], 
     RowBox[{"Epilog", "->", 
      RowBox[{"{", 
       RowBox[{"(*", 
        RowBox[{"Main", " ", "annotation", " ", "box", " ", "matching", " ", 
         RowBox[{"ycw", "[", "x", "]"}], " ", "color", " ", 
         RowBox[{"(", "red", ")"}]}], "*)"}], 
       RowBox[{
        RowBox[{"Inset", "[", 
         RowBox[{
          RowBox[{"Framed", "[", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{
             "\"\<\[Mu] -> e \[Gamma]\>\"", ",", "Black", ",", "Bold", ",", 
              "9"}], "]"}], ",", 
            RowBox[{"Background", "->", 
             RowBox[{"RGBColor", "[", 
              RowBox[{"1", ",", "0.4", ",", "0.4"}], "]"}]}], ",", 
            RowBox[{"RoundingRadius", "->", "5"}]}], "]"}], ",", 
          RowBox[{"Scaled", "[", 
           RowBox[{"{", 
            RowBox[{"0.8", ",", "0.937"}], "}"}], "]"}]}], "]"}], ",", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"Matching", " ", "L"}], "=", 
          RowBox[{
          "1", " ", "fm", " ", "annotation", " ", "box", " ", "with", " ", 
           RowBox[{"y1", "[", "x", "]"}], " ", "color", " ", 
           RowBox[{"(", 
            RowBox[{"light", " ", "green"}], ")"}]}]}], "*)"}], 
        RowBox[{"Inset", "[", 
         RowBox[{
          RowBox[{"Framed", "[", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{"\"\<L = 1 m\>\"", ",", "Black", ",", "Bold", ",", "9"}],
              "]"}], ",", 
            RowBox[{"Background", "->", 
             RowBox[{"RGBColor", "[", 
              RowBox[{"0.4", ",", "1", ",", "0.4"}], "]"}]}], ",", 
            RowBox[{"RoundingRadius", "->", "5"}]}], "]"}], ",", 
          RowBox[{"Scaled", "[", 
           RowBox[{"{", 
            RowBox[{"0.9", ",", "0.70"}], "}"}], "]"}]}], "]"}], ",", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"Matching", " ", "L"}], "=", 
          RowBox[{
          "1", " ", "\[Mu]m", " ", "annotation", " ", "box", " ", "with", " ", 
           RowBox[{"y2", "[", "x", "]"}], " ", "color", " ", 
           RowBox[{"(", "blue", ")"}]}]}], "*)"}], 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"Inset", "[", 
           RowBox[{
            RowBox[{"Framed", "[", 
             RowBox[{
              RowBox[{"Style", "[", 
               RowBox[{
               "\"\<L = 1 \[Mu]m\>\"", ",", "White", ",", "Bold", ",", "9"}], 
               "]"}], ",", 
              RowBox[{"Background", "->", 
               RowBox[{"RGBColor", "[", 
                RowBox[{"0.4", ",", "0.4", ",", "1"}], "]"}]}], ",", 
              RowBox[{"RoundingRadius", "->", "5"}]}], "]"}], ",", 
            RowBox[{"Scaled", "[", 
             RowBox[{"{", 
              RowBox[{"0.7", ",", "0.50"}], "}"}], "]"}]}], "]"}], ","}], 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"Matching", " ", "L"}], "=", 
           RowBox[{
           "1", " ", "\[Mu]m", " ", "annotation", " ", "box", " ", "with", 
            " ", 
            RowBox[{"y3", "[", "x", "]"}], " ", "color", " ", 
            RowBox[{"(", "purple", ")"}]}]}], "*)"}], "*)"}], 
        RowBox[{"Inset", "[", 
         RowBox[{
          RowBox[{"Framed", "[", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{
             "\"\<L = \!\(\*SuperscriptBox[\(10\), \(3\)]\) Km\>\"", ",", 
              "White", ",", "Bold", ",", "9"}], "]"}], ",", 
            RowBox[{"Background", "->", 
             RowBox[{"RGBColor", "[", 
              RowBox[{"0.6", ",", "0.3", ",", "1"}], "]"}]}], ",", 
            RowBox[{"RoundingRadius", "->", "5"}]}], "]"}], ",", 
          RowBox[{"Scaled", "[", 
           RowBox[{"{", 
            RowBox[{"0.5", ",", "0.4"}], "}"}], "]"}]}], "]"}], ",", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"Matching", " ", "L"}], "=", 
          RowBox[{
           RowBox[{"10", "^", "3"}], " ", "Km", " ", "annotation", " ", "box",
            " ", "with", " ", "orange", " ", "color"}]}], "*)"}], 
        RowBox[{"Inset", "[", 
         RowBox[{
          RowBox[{"Framed", "[", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{
             "\"\<L = 1 Gpc\>\"", ",", "Black", ",", "Bold", ",", "9"}], 
