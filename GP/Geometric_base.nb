Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"innerProductcwtot", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"i", "+", "j"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "3"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "3"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Compute", " ", "the", " ", "all", " ", "possible", " ", "inner", " ", 
    "products", " ", "for", " ", "total", " ", "phase"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"i", "=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"While", "[", 
  RowBox[{
   RowBox[{"i", "<", 
    RowBox[{"3", "+", "1"}]}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"j", "=", "1"}], ";", "\[IndentingNewLine]", 
      RowBox[{"While", "[", 
       RowBox[{
        RowBox[{"j", "<", 
         RowBox[{"3", "+", "1"}]}], ",", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"innerProductcwtot", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "j"}], "]"}], "]"}], "=", 
           RowBox[{
            RowBox[{
             RowBox[{"Conjugate", "[", 
              RowBox[{"psitcw", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "]"}], ".", 
             RowBox[{"psicw", "[", 
              RowBox[{"[", "j", "]"}], "]"}]}], "//", "Expand"}]}], "}"}], 
         ";", 
         RowBox[{"j", "++"}]}]}], "]"}]}], "}"}], ";", 
    RowBox[{"i", "++"}]}]}], "]"}]}], "Input",
