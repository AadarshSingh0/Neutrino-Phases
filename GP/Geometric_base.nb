Cell[BoxData[{
 RowBox[{
  RowBox[{"y1", "[", "x_", "]"}], ":=", 
  RowBox[{"Sqrt", "[", 
   RowBox[{
    RowBox[{"10", "^", 
     RowBox[{"(", "9", ")"}]}], " ", "2", " ", "\[Pi]", " ", 
    RowBox[{"0.2", "/", "x"}]}], "]"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"y2", "[", "x_", "]"}], ":=", 
   RowBox[{"Sqrt", "[", 
    RowBox[{
     RowBox[{"10", "^", 
      RowBox[{"(", "3", ")"}]}], " ", "2", " ", "\[Pi]", " ", 
     RowBox[{"0.2", "/", "x"}]}], "]"}]}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"colors", "=", 
    RowBox[{"{", 
     RowBox[{"Red", ",", 
      RowBox[{"RGBColor", "[", 
       RowBox[{"0", ",", "0.6", ",", "0.8"}], "]"}], ",", 
      RowBox[{"RGBColor", "[", 
       RowBox[{"0.8", ",", "0.4", ",", "0"}], "]"}], ",", 
      RowBox[{"RGBColor", "[", 
       RowBox[{"0.4", ",", "0.6", ",", "0"}], "]"}]}], "}"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{"LogPlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"y1", "[", "x", "]"}], ",", 
     RowBox[{"y2", "[", "x", "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0.1", ",", 
     RowBox[{"10", "^", "3"}]}], "}"}], ",", 
   RowBox[{"PlotLabel", "->", 
    RowBox[{"Labeled", "[", 
     RowBox[{
     "\"\<Plot of Log10 of n vs \\!\\(\\*SubscriptBox[\\(L\\), \
\\(Coherence\\)]\\)\>\"", ",", 
      RowBox[{"Spacer", "[", "5", "]"}]}], "]"}]}], ",", 
   RowBox[{"Axes", "->", "False"}], ",", 
   RowBox[{"Frame", "->", "True"}], ",", 
   RowBox[{"FrameLabel", "->", 
    RowBox[{"{", 
     RowBox[{
     "\"\<\\!\\(\\*SubscriptBox[\\(L\\), \\(Coherence\\)]\\) (Km)\>\"", ",", 
      "\"\<Log10(n)\>\"", ",", "None", ",", "None"}], "}"}]}], ",", 
   RowBox[{"FrameStyle", "->", "Black"}], ",", 
   RowBox[{"FrameTicks", "->", 
    RowBox[{"{", 
     RowBox[{"Automatic", ",", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"10", "^", "n"}], ",", "n"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"n", ",", "0", ",", "15", ",", "2"}], "}"}]}], "]"}]}], 
     "}"}]}], ",", 
   RowBox[{"PlotLegends", "->", 
    RowBox[{"Placed", "[", 
     RowBox[{
      RowBox[{"LineLegend", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{"\"\<R = 0.2 \[Mu]m\>\"", ",", 
            RowBox[{"colors", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ",", 
          RowBox[{"Style", "[", 
