Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Energy", "=", 
     RowBox[{"1", " ", "PeV"}]}], ",", 
    RowBox[{"Length", " ", "for", " ", "y"}], ",", 
    RowBox[{"L", "=", 
     RowBox[{
      SuperscriptBox["10", "3"], " ", "Km", " ", "and", " ", "for", " ", 
      "y1"}]}], ",", 
    RowBox[{"L", "=", 
     RowBox[{"1", " ", "\[Micro]m"}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"y2", "[", "x_", "]"}], ":=", 
    RowBox[{
     RowBox[{"Sqrt", "[", 
      RowBox[{"10", "^", 
       RowBox[{"(", "3", ")"}]}], "]"}], "/", "x"}]}], "\[IndentingNewLine]", 
   
   RowBox[{
    RowBox[{"y3", "[", "x_", "]"}], ":=", 
    RowBox[{
     RowBox[{"Sqrt", "[", 
      RowBox[{"10", "^", 
       RowBox[{"(", 
        RowBox[{"-", "3"}], ")"}]}], "]"}], "/", "x"}]}], "\n", 
   RowBox[{
    RowBox[{"y4", "[", "x_", "]"}], ":=", 
    RowBox[{
     RowBox[{"Sqrt", "[", 
      RowBox[{"10", "^", 
       RowBox[{"(", 
        RowBox[{"-", "6"}], ")"}]}], "]"}], "/", "x"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"LogLogPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"y2", "[", "x", "]"}], ",", 
       RowBox[{"y3", "[", "x", "]"}], ",", 
       RowBox[{"y4", "[", "x", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"10", "^", "1"}], ",", 
       RowBox[{"10", "^", "14"}]}], "}"}], ",", 
     RowBox[{"PlotLabel", "->", "\"\<Plot of Log10 of mass (eV) vs y\>\""}], 
     ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<Log10(m) (eV)\>\"", ",", "\"\<Log10(y)\>\""}], "}"}]}], 
     ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Directive", "[", 
         RowBox[{
          RowBox[{"RGBColor", "[", 
           RowBox[{"1", ",", "0.4", ",", "0.4"}], "]"}], ",", "Thick"}], 
         "]"}], ",", 
        RowBox[{"Directive", "[", 
         RowBox[{
          RowBox[{"RGBColor", "[", 
           RowBox[{"1", ",", "0.4", ",", "0.4"}], "]"}], ",", "Thick"}], 
         "]"}]}], "}"}]}], ",", 
     RowBox[{"Filling", "->", 
      RowBox[{"{", 
       RowBox[{"1", "->", 
        RowBox[{"{", "2", "}"}]}], "}"}]}], ",", 
     RowBox[{"FillingStyle", "->", "LightBlue"}], ",", 
     RowBox[{"AxesStyle", "->", "Black"}], ",", 
     RowBox[{"LabelStyle", "->", 
      RowBox[{"Directive", "[", 
       RowBox[{"Black", ",", "Bold"}], "]"}]}], ",", 
     RowBox[{"Ticks", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"10", "^", "n"}], ",", "n"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"n", ",", "1", ",", "15"}], "}"}]}], "]"}], ",", 
        RowBox[{"(*", 
         RowBox[{"x", "-", 
          RowBox[{"axis", " ", "ticks"}]}], "*)"}], 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"10", "^", "m"}], ",", "m"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"m", ",", 
            RowBox[{"-", "16"}], ",", "3", ",", "2"}], "}"}]}], "]"}]}], "  ", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"y", "-", 
          RowBox[{"axis", " ", "ticks"}]}], ",", 
