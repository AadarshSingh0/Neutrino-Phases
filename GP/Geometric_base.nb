            RowBox[{"\"\<neff < 0.395\>\"", ",", "Red"}], "]"}], ",", 
           RowBox[{"Style", "[", 
            RowBox[{"\"\<neff*m < 0.06\>\"", ",", "Blue"}], "]"}]}], "}"}], 
         ",", 
