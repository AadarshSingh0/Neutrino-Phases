Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"y2", "[", "x_", "]"}], ":=", 
   RowBox[{
    RowBox[{"10", "/", "x"}], " ", "+", 
    RowBox[{"0.01", "x"}]}]}], "\[IndentingNewLine]"}], "\n", 
