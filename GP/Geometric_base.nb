Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "First", " ", "create", " ", "plots", " ", "for", " ", "the", " ", 
    "colored", " ", "lines"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"yminsndPlot", "=", 
     RowBox[{"LogLogPlot", "[", 
      RowBox[{
       RowBox[{"ycwlow", "[", 
        RowBox[{"100", ",", "0.48"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "0.1", ",", "minsnd"}], "}"}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"Directive", "[", 
         RowBox[{
          RowBox[{"colorList", "[", 
           RowBox[{"[", "4", "]"}], "]"}], ",", 
          RowBox[{"AbsoluteDashing", "[", 
           RowBox[{"{", 
            RowBox[{"8", ",", "3", ",", "2", ",", "3", ",", "2", ",", "3"}], 
            "}"}], "]"}]}], "]"}]}], ",", 
       RowBox[{"PlotLegends", "->", 
        RowBox[{"{", 
         RowBox[{"Style", "[", 
          RowBox[{"\"\<SND E = 100 GeV\>\"", ",", 
           RowBox[{"FontSize", "->", "12"}], ",", 
           RowBox[{"FontFamily", "->", "\"\<Andika\>\""}]}], "]"}], "}"}]}]}],
       "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Create", " ", "the", " ", "SND", " ", "1", " ", "TeV", " ", "line", " ", 
     "WITHOUT", " ", "filling"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ymaxsndLinePlot", "=", 
     RowBox[{"LogLogPlot", "[", 
      RowBox[{
       RowBox[{"ycwhigh", "[", 
        RowBox[{"2000", ",", "0.48"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "0.1", ",", "maxsnd"}], "}"}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"Directive", "[", 
         RowBox[{
          RowBox[{"colorList", "[", 
           RowBox[{"[", "4", "]"}], "]"}], ",", "Dashing"}], "]"}]}], ",", 
       RowBox[{"PlotLegends", "->", 
        RowBox[{"{", 
         RowBox[{"Style", "[", 
          RowBox[{"\"\<SND E = 1 TeV\>\"", ",", 
           RowBox[{"FontSize", "->", "12"}], ",", 
           RowBox[{"FontFamily", "->", "\"\<Andika\>\""}]}], "]"}], "}"}]}]}],
       "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "Create", " ", "the", " ", "gray", " ", "region", " ", "separately"}], 
     "-", 
     RowBox[{"this", " ", "will", " ", "be", " ", "drawn", " ", "LAST"}]}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"grayRegionPlot", "=", 
     RowBox[{"LogLogPlot", "[", 
      RowBox[{
       RowBox[{"pert", "[", "x", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "0.1", ",", "maxsnd"}], "}"}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"Directive", "[", 
         RowBox[{"Gray", ",", "Thick"}], "]"}]}], ",", 
       RowBox[{"Filling", "->", "Top"}], ",", 
       RowBox[{"FillingStyle", "->", 
        RowBox[{"Directive", "[", 
         RowBox[{
          RowBox[{"Opacity", "[", "1", "]"}], ",", "Gray"}], "]"}]}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Merge", " ", "the", " ", "plots"}], "-", 
     RowBox[{
     "gray", " ", "region", " ", "LAST", " ", "so", " ", "it", " ", "appears",
       " ", "on", " ", "top"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"sndplot", "=", 
    RowBox[{"Show", "[", 
     RowBox[{
     "yminsndPlot", ",", "ymaxsndLinePlot", ",", "grayRegionPlot", ",", 
      RowBox[{"PlotLabel", "->", "\"\<Plot of mass (eV) vs y\>\""}], ",", 
      RowBox[{"LabelStyle", "->", 
       RowBox[{"Directive", "[", 
        RowBox[{"Black", ",", "Bold"}], "]"}]}], ",", 
      RowBox[{"PlotRange", "->", 
       RowBox[{"{", 
        RowBox[{"All", ",", 
         RowBox[{"{", 
          RowBox[{"Automatic", ",", 
           RowBox[{"-", "10"}]}], "}"}]}], "}"}]}], ",", 
      RowBox[{"Frame", "->", "True"}], ",", 
      RowBox[{"FrameLabel", "->", 
       RowBox[{"{", 
        RowBox[{
        "\"\<m (eV)\>\"", ",", "\"\<y\>\"", ",", "None", ",", "None"}], 
        "}"}]}], ",", 
      RowBox[{"FrameStyle", "->", "Black"}]}], "]"}]}]}]}]], "Input",
