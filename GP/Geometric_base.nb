Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Specify", " ", "the", " ", "number", " ", "of", " ", "dimensions"}], 
   "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"numDimensions", "=", "ncw"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Create", " ", "a", " ", "list", " ", "to", " ", "store", " ", "all", " ",
      "kets"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"allKets", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Loop", " ", "to", " ", "create", " ", "each", " ", "ket"}], 
    "*)"}], "\n", 
   RowBox[{"For", "[", 
    RowBox[{
     RowBox[{"i", "=", "1"}], ",", 
     RowBox[{"i", "<=", "numDimensions"}], ",", 
     RowBox[{"i", "++"}], ",", 
     RowBox[{"(*", 
      RowBox[{"Create", " ", "a", " ", "vector", " ", "of", " ", "zeros"}], 
      "*)"}], 
     RowBox[{
      RowBox[{"tempket", "=", 
       RowBox[{"Table", "[", 
        RowBox[{"0", ",", 
         RowBox[{"{", "numDimensions", "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Set", " ", "the", " ", "i"}], "-", 
        RowBox[{"th", " ", "element", " ", "to", " ", "1"}]}], "*)"}], 
      RowBox[{
       RowBox[{"tempket", "[", 
        RowBox[{"[", "i", "]"}], "]"}], "=", "1"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Add", " ", "the", " ", "ket", " ", "to", " ", "our", " ", "list"}], 
       "*)"}], 
      RowBox[{"AppendTo", "[", 
       RowBox[{"allKets", ",", "tempket"}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Define", " ", "a", " ", "variable", " ", "for", " ", "this", " ", 
        "ket", " ", "using", " ", "ToExpression"}], "*)"}], 
      RowBox[{"ToExpression", "[", 
       RowBox[{"\"\<ketcw\>\"", "<>", 
        RowBox[{"ToString", "[", "i", "]"}], "<>", "\"\< = \>\"", "<>", 
        RowBox[{"ToString", "[", "tempket", "]"}]}], "]"}], ";"}]}], 
    "]"}]}]}]], "Input",
