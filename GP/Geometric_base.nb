Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"innerProductsmtot", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"i", "+", "j"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "nsm"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "nsm"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Compute", " ", "the", " ", "all", " ", "possible", " ", "inner", " ", 
    "products", " ", "for", " ", "total", " ", "phase"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"i", "=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"While", "[", 
  RowBox[{
   RowBox[{"i", "<", 
    RowBox[{"nsm", "+", "1"}]}], ",", 
