Cell[BoxData[{
 RowBox[{
  RowBox[{"functionPlot", "=", 
   RowBox[{"LogLogPlot", "[", 
    RowBox[{
     RowBox[{"f", "[", "x", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"10", "^", 
        RowBox[{"-", "2"}]}], ",", 
       RowBox[{"10", "^", "2"}]}], "}"}], ",", 
