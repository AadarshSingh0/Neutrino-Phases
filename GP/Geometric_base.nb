Cell[BoxData[{
 RowBox[{
  RowBox[{"y1", "[", "x_", "]"}], ":=", 
  RowBox[{"Sqrt", "[", 
   RowBox[{
    RowBox[{"10", "^", 
     RowBox[{"(", 
      RowBox[{"-", "10"}], ")"}]}], " ", "0.2", " ", 
    RowBox[{"x", "/", 
     RowBox[{"(", 
      RowBox[{"2", " ", "\[Pi]"}], ")"}]}]}], "]"}]}], "\n", 
 RowBox[{
  RowBox[{"y2", "[", "x_", "]"}], ":=", 
