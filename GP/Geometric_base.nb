   RowBox[{"(*", 
    RowBox[{"Makes", " ", "frame", " ", "ticks", " ", "darker"}], "*)"}], 
   RowBox[{"BaseStyle", "->", 
    RowBox[{"{", 
     RowBox[{"FontSize", "->", "8"}], "}"}]}]}], "  ", 
  RowBox[{"(*", 
