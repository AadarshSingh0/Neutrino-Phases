Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Define", " ", "the", " ", "ranges", " ", "for", " ", "plotting"}],
    "*)"}], 
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"0.395", ",", 
      RowBox[{"(*", 
       RowBox[{"First", " ", 
        RowBox[{"constraint", ":", 
         RowBox[{"neff", "<", "0.395"}]}]}], "*)"}], 
      RowBox[{"0.06", "/", "m"}], "  ", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Second", " ", 
         RowBox[{"constraint", ":", 
          RowBox[{
           RowBox[{"neff", "*", "m"}], "<", "0.06"}]}]}], ",", 
        RowBox[{
         RowBox[{"rearranged", " ", "as", " ", "neff"}], "<", 
         RowBox[{"0.06", "/", "m"}]}]}], "*)"}], ",", 
      RowBox[{"0.09", "/", "m"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"m", ",", "0.1", ",", "10000"}], "}"}], ",", 
    RowBox[{"(*", 
     RowBox[{
     "m", " ", "range", " ", "from", " ", "0.01", " ", "to", " ", "1"}], 
     "*)"}], 
    RowBox[{"PlotRange", "->", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"01", ",", "10000"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0.5"}], "}"}]}], "}"}]}], ",", 
    RowBox[{"Frame", "->", "True"}], ",", 
    RowBox[{"FrameLabel", "->", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Style", "[", 
        RowBox[{"\"\<m (eV)\>\"", ",", "Bold", ",", "14"}], "]"}], ",", 
       RowBox[{"Style", "[", 
        RowBox[{"\"\<neff\>\"", ",", "Bold", ",", "14"}], "]"}]}], "}"}]}], 
    ",", 
    RowBox[{"PlotStyle", "->", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"Red", ",", "Thick", ",", "Dashed"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"Blue", ",", "Thick"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"Green", ",", "Thick"}], "}"}]}], "}"}]}], ",", 
    RowBox[{"Filling", "->", 
