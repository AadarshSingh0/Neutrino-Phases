Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DensityPlot", "[", 
  RowBox[{
   RowBox[{"SetPrecision", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"ftxcw", "[", 
       RowBox[{"x", ",", "y"}], "]"}], "*", 
      RowBox[{"(", 
       RowBox[{"180", "/", "Pi"}], ")"}]}], ",", "50"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "4.25"}], ",", "4.25"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"y", ",", 
     RowBox[{"-", "4.25"}], ",", "4.25"}], "}"}], ",", 
   RowBox[{"ColorFunction", "->", "\"\<Rainbow\>\""}], ",", 
   RowBox[{"PlotPoints", "->", "50"}], ",", 
   RowBox[{"Frame", "->", "True"}], ",", 
   RowBox[{"FrameLabel", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Style", "[", 
       RowBox[{"\"\<\[Theta] (radians)\>\"", ",", "Black", ",", "16"}], "]"}],
       ",", 
      RowBox[{"Style", "[", 
       RowBox[{"\"\<t\>\"", ",", "Black", ",", "16"}], "]"}]}], "}"}]}], ",", 
   
   RowBox[{"PlotLabel", "->", 
    RowBox[{"Style", "[", 
     RowBox[{
     "\"\<Density Plot of Total Phase (degree)\>\"", ",", "Black", ",", 
      "Bold", ",", "12"}], "]"}]}], ",", 
   RowBox[{"Mesh", "->", "False"}], ",", 
   RowBox[{"ColorFunctionScaling", "->", "True"}], ",", 
   RowBox[{"PlotLegends", "->", "Automatic"}], ",", 
   RowBox[{"FrameStyle", "->", 
    RowBox[{"Directive", "[", "Black", "]"}]}], ",", 
   RowBox[{"(*", 
    RowBox[{"Makes", " ", "frame", " ", "darker"}], "*)"}], 
   RowBox[{"FrameTicksStyle", "->", 
    RowBox[{"Directive", "[", 
     RowBox[{"Black", ",", "8"}], "]"}]}], ",", 
   RowBox[{"(*", 
    RowBox[{"Makes", " ", "frame", " ", "ticks", " ", "darker"}], "*)"}], 
   RowBox[{"BaseStyle", "->", 
    RowBox[{"{", 
     RowBox[{"FontSize", "->", "8"}], "}"}]}]}], "  ", 
  RowBox[{"(*", 
   RowBox[{"Overall", " ", "style"}], "*)"}], "]"}]], "Input",
