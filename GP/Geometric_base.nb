Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Energy", "=", 
     RowBox[{"1", " ", "MeV"}]}], ",", 
    RowBox[{"Length", " ", "for", " ", "y"}], ",", 
    RowBox[{"L", "=", 
     RowBox[{
      RowBox[{"10", "^", "3"}], " ", "Km", " ", "and", " ", "for", " ", 
      "y1"}]}], ",", 
    RowBox[{"L", "=", 
     RowBox[{"1", " ", "\[Micro]m"}]}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"y", "[", "x_", "]"}], ":=", 
    RowBox[{
     RowBox[{"10", "^", 
      RowBox[{"(", 
