Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"fnx", "=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"a", "^", "2"}], "*", 
      RowBox[{"Sin", "[", "x", "]"}]}], "+", 
     RowBox[{
      RowBox[{"b", "^", "2"}], "*", 
      RowBox[{"Sin", "[", 
       RowBox[{"2", "x"}], "]"}]}], "+", 
     RowBox[{
      RowBox[{"c", "^", "2"}], "*", 
      RowBox[{"Sin", "[", 
       RowBox[{"3", "x"}], "]"}]}]}], ")"}], "/", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"a", "^", "2"}], "*", 
      RowBox[{"Cos", "[", "x", "]"}]}], "+", 
