     ",", 
     RowBox[{"PlotRange", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"10", "^", "1"}], ",", "Automatic"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"Automatic", ",", "1"}], "}"}]}], "}"}]}]}], "  ", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{
       RowBox[{"Limit", " ", "y"}], "-", 
       RowBox[{"axis", " ", "to"}]}], "\[LessEqual]", "1"}], "*)"}], "]"}], 
   "\n"}]}]], "Input",
