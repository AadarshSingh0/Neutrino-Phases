Cell[BoxData[
 RowBox[{"DensityPlot", "[", 
  RowBox[{
   RowBox[{"SetPrecision", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"ftx", "[", 
       RowBox[{"x", ",", "y"}], "]"}], "*", 
      RowBox[{"(", 
       RowBox[{"180", "/", "Pi"}], ")"}]}], ",", "50"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "6.25"}], ",", "6.25"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"y", ",", 
     RowBox[{"-", "6.25"}], ",", "6.25"}], "}"}], ",", 
   RowBox[{"ColorFunction", "->", "\"\<Rainbow\>\""}], ",", 
   RowBox[{"PlotPoints", "->", "50"}], ",", 
   RowBox[{"Frame", "->", "True"}], ",", 
   RowBox[{"FrameLabel", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Style", "[", 
       RowBox[{"\"\<\[Theta] (radians)\>\"", ",", "Black", ",", "16"}], "]"}],
       ",", 
      RowBox[{"Style", "[", 
       RowBox[{"\"\<t\>\"", ",", "Black", ",", "16"}], "]"}]}], "}"}]}], ",", 
   
   RowBox[{"PlotLabel", "->", 
    RowBox[{"Style", "[", 
     RowBox[{
     "\"\<Density Plot of Dynamical Phase (degree)\>\"", ",", "Black", ",", 
      "Bold", ",", "12"}], "]"}]}], ",", 
   RowBox[{"Mesh", "->", "False"}], ",", 
   RowBox[{"ColorFunctionScaling", "->", "True"}], ",", 
   RowBox[{"PlotLegends", "->", "Automatic"}], ",", 
   RowBox[{"FrameStyle", "->", 
    RowBox[{"Directive", "[", "Black", "]"}]}], ",", 
   RowBox[{"(*", 
