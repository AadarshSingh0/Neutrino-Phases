Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Energy", "=", 
     RowBox[{"1", " ", "GeV"}]}], ",", 
    RowBox[{"Length", " ", "for", " ", "y"}], ",", 
    RowBox[{"L", "=", 
     RowBox[{
      RowBox[{"10", "^", "3"}], " ", "Km", " ", "and", " ", "for", " ", 
      "y1"}]}], ",", 
    RowBox[{"L", "=", 
     RowBox[{"1", " ", "\[Micro]m"}]}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"y", "[", "x_", "]"}], ":=", 
    RowBox[{
     RowBox[{"Sqrt", "[", 
      RowBox[{"10", "^", 
       RowBox[{"(", 
        RowBox[{"-", "3"}], ")"}]}], "]"}], "/", "x"}]}], "\n", 
   RowBox[{
    RowBox[{"y1", "[", "x_", "]"}], ":=", 
