Cell[BoxData[{
 RowBox[{
  RowBox[{"y1", "[", "x_", "]"}], ":=", 
  RowBox[{"Sqrt", "[", 
   RowBox[{
    RowBox[{"10", "^", 
     RowBox[{"(", "9", ")"}]}], " ", "2", " ", "\[Pi]", " ", 
    RowBox[{"0.2", "/", "x"}]}], "]"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"y2", "[", "x_", "]"}], ":=", 
   RowBox[{"Sqrt", "[", 
    RowBox[{
     RowBox[{"10", "^", 
      RowBox[{"(", "3", ")"}]}], " ", "2", " ", "\[Pi]", " ", 
     RowBox[{"0.2", "/", "x"}]}], "]"}]}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"colors", "=", 
    RowBox[{"{", 
