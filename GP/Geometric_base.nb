          RowBox[{"10", "^", "1"}], ",", 
          RowBox[{"10", "^", "5"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"Automatic", ",", "1"}], "}"}]}], "}"}]}], ",", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{
        RowBox[{"Limit", " ", "y"}], "-", 
        RowBox[{"axis", " ", "to"}]}], "\[LessEqual]", "1"}], "*)"}], 
