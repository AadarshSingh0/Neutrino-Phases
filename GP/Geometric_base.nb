Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"yminastroPlot", "=", 
    RowBox[{"LogLogPlot", "[", 
     RowBox[{
      RowBox[{"yminastro", "[", "x", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "0.1", ",", "minastro"}], "}"}], ",", 
      RowBox[{"PlotStyle", "->", 
       RowBox[{"Directive", "[", 
        RowBox[{
         RowBox[{"colorList", "[", 
          RowBox[{"[", "11", "]"}], "]"}], ",", 
         RowBox[{"AbsoluteDashing", "[", 
          RowBox[{"{", 
           RowBox[{"8", ",", "3", ",", "2", ",", "3", ",", "2", ",", "3"}], 
           "}"}], "]"}], ",", 
         RowBox[{"Opacity", "[", "0.7", "]"}]}], "]"}]}], ",", 
      RowBox[{"PlotLegends", "->", 
       RowBox[{"{", 
        RowBox[{"Style", "[", 
         RowBox[{"\"\<Astro E = 1 TeV\>\"", ",", 
          RowBox[{"FontSize", "->", "12"}], ",", 
          RowBox[{"FontFamily", "->", "\"\<Andika\>\""}]}], "]"}], "}"}]}], 
      ",", 
      RowBox[{"ClippingStyle", "->", "None"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ymaxastroPlot", "=", 
    RowBox[{"LogLogPlot", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ymaxastro", "[", "x", "]"}], "}"}], ",", 
