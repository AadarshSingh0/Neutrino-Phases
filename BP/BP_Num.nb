         RowBox[{"[", 
          RowBox[{"All", ",", "3"}], "]"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"dens", "=", 
       RowBox[{"ListDensityPlot", "[", 
        RowBox[{"dat", ",", 
         RowBox[{"InterpolationOrder", "->", "3"}], ",", 
         RowBox[{"PlotRange", "->", "All"}], ",", 
