Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"lamk", "[", 
    RowBox[{"k_", ",", "x_", ",", "y_", ",", "En_"}], "]"}], ":=", 
   RowBox[{"Switch", "[", 
    RowBox[{"k", ",", "1", ",", 
     RowBox[{"\[Lambda]1", "[", 
