      RowBox[{"x_", ",", "y_", ",", "En_", ",", "m4sq_", ",", "p_"}], "]"}], ":=", 
     RowBox[{"N", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"U4", "[", "p", "]"}], ".", 
        RowBox[{"DiagonalMatrix", "[", 
         RowBox[{"{", 
          RowBox[{"0", ",", "dm21v", ",", "dm31v", ",", "m4sq"}], "}"}], 
         "]"}], ".", 
        RowBox[{"ConjugateTranspose", "[", 
         RowBox[{"U4", "[", "p", "]"}], "]"}]}], "+", 
       RowBox[{"DiagonalMatrix", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"kcc", " ", "En", " ", 
           RowBox[{"(", 
            RowBox[{"x", "-", 
             RowBox[{"y", "/", "2"}]}], ")"}]}], ",", 
          RowBox[{
           RowBox[{"-", "kcc"}], " ", "En", " ", 
           RowBox[{"y", "/", "2"}]}], ",", 
          RowBox[{
           RowBox[{"-", "kcc"}], " ", "En", " ", 
           RowBox[{"y", "/", "2"}]}], ",", "0"}], "}"}], "]"}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"evec", "[", 
      RowBox[{
      "x_", ",", "y_", ",", "En_", ",", "m4sq_", ",", "p_", ",", "i_"}], 
      "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"es", "=", 
          RowBox[{"Eigensystem", "[", 
           RowBox[{"Hmat", "[", 
            RowBox[{"x", ",", "y", ",", "En", ",", "m4sq", ",", "p"}], "]"}], 
           "]"}]}], ",", "ord"}], "}"}], ",", 
       RowBox[{
        RowBox[{"ord", "=", 
         RowBox[{"Ordering", "[", 
          RowBox[{"Re", "[", 
           RowBox[{"es", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}]}], ";", 
        RowBox[{"Normalize", "[", 
         RowBox[{"es", "[", 
          RowBox[{"[", 
           RowBox[{"2", ",", 
            RowBox[{"ord", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}], "]"}], "]"}], "]"}]}]}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"wilsonBP", "[", 
      RowBox[{
      "i_", ",", "xmax_", ",", "ymax_", ",", "En_", ",", "m4sq_", ",", "p_", 
       ",", "n_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"pts", ",", "vs"}], "}"}], ",", 
       RowBox[{
        RowBox[{"pts", "=", 
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"xmax", " ", 
                RowBox[{"t", "/", "n"}]}], ",", "0"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"t", ",", "0", ",", 
               RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}], ",", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"xmax", ",", 
               RowBox[{"ymax", " ", 
                RowBox[{"t", "/", "n"}]}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"t", ",", "0", ",", 
               RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}], ",", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"xmax", " ", 
                RowBox[{"(", 
                 RowBox[{"1", "-", 
                  RowBox[{"t", "/", "n"}]}], ")"}]}], ",", "ymax"}], "}"}], 
             ",", 
             RowBox[{"{", 
              RowBox[{"t", ",", "0", ",", 
               RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}], ",", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"0", ",", 
               RowBox[{"ymax", " ", 
                RowBox[{"(", 
                 RowBox[{"1", "-", 
                  RowBox[{"t", "/", "n"}]}], ")"}]}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"t", ",", "0", ",", 
               RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"vs", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"evec", "[", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", 
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", "En", ",", "m4sq", ",", 
             "p", ",", "i"}], "]"}], "&"}], "/@", "pts"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"-", 
         RowBox[{"Arg", "[", 
          RowBox[{"Times", "@@", 
           RowBox[{"MapThread", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"Conjugate", "[", "#1", "]"}], ".", "#2"}], "&"}], ",", 
             RowBox[{"{", 
              RowBox[{"vs", ",", 
               RowBox[{"RotateLeft", "[", "vs", "]"}]}], "}"}]}], "]"}]}], 
          "]"}]}]}]}], "]"}]}], ";"}]}]}]], "Input",
