 RowBox[{
  RowBox[{
   RowBox[{"vS", "[", 
    RowBox[{"k_", ",", "x_", ",", "y_", ",", "En_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"c", "=", "Conjugate"}], ",", 
       RowBox[{"l", "=", 
        RowBox[{"lamk", "[", 
         RowBox[{"k", ",", "x", ",", "y", ",", "En"}], "]"}]}], ",", 
       RowBox[{"a12", "=", 
        RowBox[{"an", "[", 
