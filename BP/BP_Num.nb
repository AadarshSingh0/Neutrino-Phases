 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"3", "-", 
      RowBox[{"flavour", " ", "limit", " ", 
       RowBox[{"(", 
        RowBox[{"Sec", ".", "4.1"}], ")"}]}]}], ":", 
     RowBox[{
      RowBox[{"with", " ", "no", " ", "active"}], "-", 
      RowBox[{"sterile", " ", "mixing", " ", 
       RowBox[{"(", 
        RowBox[{"p", "=", "0"}], ")"}], " ", "the", " ", "neutron", " ", 
       "density", " ", "shifts", " ", "all", " ", "three", " ", "active", " ",
        "levels", " ", "equally"}]}]}], ",", 
