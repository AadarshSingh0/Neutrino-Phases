        "d1", ",", "d2", ",", "d3"}], "}"}], ",", 
     RowBox[{
      RowBox[{"d1", "=", 
       RowBox[{
        RowBox[{"an", "[", 
         RowBox[{"1", ",", "1", ",", "x", ",", "y", ",", "En"}], "]"}], "-", 
        "l"}]}], ";", 
      RowBox[{"d2", "=", 
       RowBox[{
        RowBox[{"an", "[", 
