            RowBox[{"Abs", "[", 
             RowBox[{"#", "[", 
              RowBox[{"[", 
               RowBox[{"3", ",", "k"}], "]"}], "]"}], "]"}], "]"}]}], "}"}], 
         "&"}], "/@", "fig3data"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
