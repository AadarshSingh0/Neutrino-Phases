                "Black"}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"#1", ",", "#2"}], "}"}]}], "]"}], "&"}], ")"}]}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Show", "[", 
       RowBox[{"dens", ",", "cont", ",", 
