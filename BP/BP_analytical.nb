       RowBox[{"Sin", "[", "dcp", "]"}]}], "-", 
      RowBox[{"c12", " ", 
       RowBox[{"c13", "^", "2"}], " ", "c23", " ", "s12", " ", "s13", " ", 
       RowBox[{"s23", "^", "3"}], " ", 
       RowBox[{"Sin", "[", "dcp", "]"}]}]}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Simplify", " ", "the", " ", "expression"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"imagExpressionSimplified", "=", 
     RowBox[{"Simplify", "[", "imagExpression", "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Plot", " ", "for", " ", "dcp", " ", "from", " ", "0", " ", "to", " ", 
