Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Current", " ", "experimental", " ", "values", " ", "from", " ", 
    "Particle", " ", "Data", " ", "Group"}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{"Mixing", " ", "angles", " ", "in", " ", "radians"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"theta12", "=", 
     RowBox[{"33.45", "*", "Degree"}]}], ";"}], "   ", 
   RowBox[{"(*", "\[Theta]12", "*)"}], "\n", 
   RowBox[{
    RowBox[{"theta13", "=", 
     RowBox[{"8.62", "*", "Degree"}]}], ";"}], "    ", 
   RowBox[{"(*", "\[Theta]13", "*)"}], "\n", 
   RowBox[{
    RowBox[{"theta23", "=", 
     RowBox[{"42.1", "*", "Degree"}]}], ";"}], "    ", 
   RowBox[{"(*", "\[Theta]23", "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Define", " ", "cosine", " ", "and", " ", "sine", " ", "functions"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"c12", "=", 
     RowBox[{"Cos", "[", "theta12", "]"}]}], ";", 
    RowBox[{"s12", "=", 
     RowBox[{"Sin", "[", "theta12", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"c13", "=", 
     RowBox[{"Cos", "[", "theta13", "]"}]}], ";", 
    RowBox[{"s13", "=", 
     RowBox[{"Sin", "[", "theta13", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"c23", "=", 
     RowBox[{"Cos", "[", "theta23", "]"}]}], ";", 
    RowBox[{"s23", "=", 
     RowBox[{"Sin", "[", "theta23", "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "The", " ", "imaginary", " ", "part", " ", "expression", " ", "from", " ",
      "previous", " ", "calculation"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"imagExpression", "=", 
     RowBox[{
      RowBox[{"2", " ", 
       RowBox[{"c12", "^", "2"}], " ", 
       RowBox[{"c13", "^", "2"}], " ", 
       RowBox[{"c23", "^", "2"}], " ", 
       RowBox[{"s13", "^", "2"}], " ", 
       RowBox[{"s23", "^", "2"}], " ", 
       RowBox[{"Cos", "[", "dcp", "]"}], " ", 
       RowBox[{"Sin", "[", "dcp", "]"}]}], "+", 
      RowBox[{"c12", " ", 
       RowBox[{"c13", "^", "3"}], " ", 
